# Environment Variables for Amara Chronicles

# Required: Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Inworld AI API Key for voice narration (get from https://studio.inworld.ai/)
# If not provided, the app will fall back to browser text-to-speech
INWORLD_API_KEY=your_inworld_api_key_base64_here
